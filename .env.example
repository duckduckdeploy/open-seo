# With Docker (docker compose up -d --build) you only need AUTH_SECRET and ENCRYPTION_KEY below;
# the database is set up for you. On a server with a domain, also set the Docker section at the end.

# Postgres (development from source; Docker sets its own)
DATABASE_URL=postgres://localhost:5432/openseo

# API
API_PORT=4100
API_URL=http://localhost:4100
APP_URL=http://localhost:3200
WEB_URL=http://localhost:3101

# 32+ random characters. Signs sessions.
AUTH_SECRET=change-me-to-a-long-random-string
# 32 bytes, base64. Encrypts stored YepAPI keys. Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# Optional: override the YepAPI base URL (tests, proxies)
YEPAPI_BASE_URL=https://api.yepapi.com

# Proxies in front of the API whose X-Forwarded-For is trusted. Leave 0 unless every request
# passes proxies you control that overwrite it.
TRUST_PROXY_HOPS=0
# A header your edge proxy sets to the visitor's address, e.g. cf-connecting-ip. Used by free tools.
# CLIENT_IP_HEADER=

# Optional: Google Search Console and Analytics. Redirect URIs to register:
#   ${APP_URL}/api/google/gsc/callback and ${APP_URL}/api/google/ga4/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: free tools on the public site, paid from this key. Unset = only the free ones work.
# FREE_TOOLS_YEPAPI_KEY=
# FREE_TOOLS_DAILY_BUDGET_USD=5
# TURNSTILE_SECRET_KEY=

# Docker on a server with a domain: docker compose --profile https up -d --build
# OPENSEO_DOMAIN=example.com
# APP_URL=https://app.example.com
# WEB_URL=https://example.com
# PUBLIC_API_URL=https://api.example.com
# POSTGRES_PASSWORD=a-long-random-password
