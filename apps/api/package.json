{
  "name": "@openseo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "db:generate": "drizzle-kit generate && drizzle-kit generate --config drizzle.data.config.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "fake-yepapi": "tsx scripts/fake-yepapi.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openseo/crawler": "workspace:*",
    "@openseo/shared": "workspace:*",
    "@openseo/yepapi": "workspace:*",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^22",
    "@types/pg": "^8",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}