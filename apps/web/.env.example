# Where the OpenSEO app lives. "Get started" and "Sign in" link to
# ${NEXT_PUBLIC_APP_URL}/sign-up and /sign-in.
NEXT_PUBLIC_APP_URL=http://localhost:3200

# Public URL of this site. Used for canonical URLs, the sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://openseo.gg

# Optional. GitHub links are only rendered when this is set.
NEXT_PUBLIC_GITHUB_URL=

# Public address of the API. Agents connect to it at /mcp. Set before build.
NEXT_PUBLIC_API_URL=http://localhost:4100

# Where the API runs. The free tools' /api/public requests are forwarded here. Set before build.
API_URL=http://localhost:4100

# Optional. Cloudflare Turnstile site key for the free tools (pair with TURNSTILE_SECRET_KEY on the API).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
